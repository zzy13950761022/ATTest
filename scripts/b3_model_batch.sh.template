#!/bin/bash
# B3 batch script - B3: direct .cpp editing (no _attest, no BLOCK markers, no stubs)
# Usage: ATTEST_CONFIG_DIR=/root/.attest_cli_ds_v4_pro MODEL=ds ./b3_model_batch.sh.template

set -eo pipefail

: "${MODEL:?MODEL env var required (qwen, ds, glm)}"
: "${CONFIG_DIR:-$ATTEST_CONFIG_DIR}"
[ -z "${CONFIG_DIR:-}" ] && CONFIG_DIR="$ATTEST_CONFIG_DIR"
[ -z "${CONFIG_DIR:-}" ] && { echo "Need CONFIG_DIR or ATTEST_CONFIG_DIR"; exit 1; }
export ATTEST_CONFIG_DIR="$CONFIG_DIR"

ATT_BIN=/root/miniconda3/envs/attest-py311/bin/attest
[ ! -x "$ATT_BIN" ] && ATT_BIN=$(command -v attest) || true

OPERATORS=(
    cholesky diag_part bitwise_xor greater
    less squared_difference eye mod
)

PROJECT_ROOT="/mnt/fangcr/ops-math-round4"
BASE_DIR="/mnt/fangcr/workspace-baseline-${MODEL}"
WORKSPACES_DIR="${BASE_DIR}/v15_${MODEL}_epoch3_fixed-b3_batch"
LOG_DIR="${WORKSPACES_DIR}/logs"
EPOCH=3
WORKERS=2
PROFILE="ascend_ut_continuous"
TIMEOUT=18000
PARALLEL_JOBS=2
BUILD_THREADS=32

mkdir -p "$WORKSPACES_DIR" "$LOG_DIR"

MODEL_DISPLAY="${MODEL_DISPLAY:-${MODEL}}"
echo "========================================="
echo "ATTest B3-${MODEL} Batch (EPOCH=${EPOCH} TIMEOUT=${TIMEOUT}) [B3: direct .cpp editing, no _attest/stubs/BLOCK markers]"
echo "Total operators: ${#OPERATORS[@]}"
echo "Parallel jobs: $PARALLEL_JOBS"
echo "Build threads: $BUILD_THREADS"
echo "Workers/attest: $WORKERS  Epoch: $EPOCH"
echo "Profile: $PROFILE"
echo "Model: $MODEL_DISPLAY"
echo "Config: $ATTEST_CONFIG_DIR"
echo "Attest binary: ${ATT_BIN}"
echo "Timestamp: $(date '+%Y-%m-%d %H:%M:%S')"
echo "========================================="
echo ""

SUMMARY="${LOG_DIR}/batch_summary.csv"
SUMMARY_LOCK="${LOG_DIR}/batch_summary.lock"
echo "operator,status,op_api_line,op_host_line,overall_line,duration_seconds" > "$SUMMARY"

COV_EXTRACT_PY='
import os, json, glob, sys
art_dir = sys.argv[1]
current = os.path.join(art_dir, "current_coverage_summary.json")
if os.path.exists(current):
    files = [current]
else:
    files = sorted(glob.glob(os.path.join(art_dir, "v*_coverage_summary.json")))
if not files:
    sys.exit(0)
with open(files[-1]) as f:
    d = json.load(f)
runs = d.get("runs", {})
gen = runs.get("generated", {})
per = gen.get("per_layer", {})
api = per.get("op_api", {}).get("line_coverage", 0) or 0.0
host = per.get("op_host", {}).get("line_coverage", 0) or 0.0
ov = gen.get("overall", {}).get("line_coverage", 0) or 0.0
print(f"{api:.1f},{host:.1f},{ov:.1f}")
'

process_op() {
    local op="$1"
    local OP_WORKSPACE="${WORKSPACES_DIR}/attest-${op}"
    local OP_PROJECT="${WORKSPACES_DIR}/project-${op}"
    local LOG_FILE="${LOG_DIR}/${op}.log"
    local START_TS
    START_TS=$(date +%s)

    # Link project from V23 workspace
    V23_BATCH="${BASE_DIR}/v15_${MODEL}_epoch3_fixed-v23_batch"
    if [ ! -d "$OP_PROJECT" ]; then
        if [ -f "${V23_BATCH}/project-${op}/build.sh" ]; then
            ln -sfn "${V23_BATCH}/project-${op}" "$OP_PROJECT"
        elif [ -f "${PROJECT_ROOT}/build.sh" ]; then
            ln -sfn "$PROJECT_ROOT" "$OP_PROJECT"
        fi
    fi

    echo "[$(date '+%H:%M:%S')] Starting ${op}..." | tee -a "$LOG_FILE"

    set +e
    timeout "$TIMEOUT" "$ATT_BIN" ascend-ut run \
        --op-path "math/${op}" \
        --workspace "$OP_WORKSPACE" \
        --project-root "$OP_PROJECT" \
        --mode full-auto \
        --epoch "$EPOCH" \
        --profile "$PROFILE" \
        --workers "$WORKERS" >> "$LOG_FILE" 2>&1
    local rc=$?
    set -e

    local END_TS
    END_TS=$(date +%s)
    local DURATION=$((END_TS - START_TS))

    local status="complete"
    if [ $rc -eq 124 ]; then
        status="timeout"
    elif [ $rc -ne 0 ]; then
        status="exit_${rc}"
    fi

    local api="-" host="-" ov="-"
    local art_dir="${OP_WORKSPACE}/.attest/artifacts/generate_code"
    if [ -d "$art_dir" ]; then
        cov_out=$(python3 -c "$COV_EXTRACT_PY" "$art_dir" 2>/dev/null || true)
        if [ -n "$cov_out" ]; then
            api=$(echo "$cov_out" | cut -d',' -f1)
            host=$(echo "$cov_out" | cut -d',' -f2)
            ov=$(echo "$cov_out" | cut -d',' -f3)
        fi
    fi

    (
        flock 200
        echo "${op},${status},${api},${host},${ov},${DURATION}" >> "$SUMMARY"
    ) 200>"$SUMMARY_LOCK"

    echo "[$(date '+%H:%M:%S')] ${op}: status=${status} api=${api} host=${host} ov=${ov} dur=${DURATION}s" | tee -a "$LOG_FILE"
}

export -f process_op
export ATT_BIN WORKSPACES_DIR LOG_DIR SUMMARY SUMMARY_LOCK COV_EXTRACT_PY
export EPOCH WORKERS PROFILE TIMEOUT PROJECT_ROOT V23_BATCH

# Run operators in parallel batches
count=0
batch=()
for op in "${OPERATORS[@]}"; do
    batch+=("$op")
    count=$((count + 1))
    if [ $count -ge "$PARALLEL_JOBS" ]; then
        for b in "${batch[@]}"; do
            process_op "$b" &
        done
        wait
        batch=()
        count=0
    fi
done
if [ ${#batch[@]} -gt 0 ]; then
    for b in "${batch[@]}"; do
        process_op "$b" &
    done
    wait
fi

echo ""
echo "========================================="
echo "B3-${MODEL} EPOCH=${EPOCH} (B3: direct .cpp editing, no _attest/stubs/BLOCK markers) Batch Complete  $(date '+%Y-%m-%d %H:%M:%S')"
echo "========================================="
cat "$SUMMARY"
